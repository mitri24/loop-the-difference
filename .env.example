# Optional overrides – copy to .env
# Only the fallback while IRSA cannot list the SPHEREx releases; every listed release is searched.
SKYSHIFT_SPHEREX_COLLECTION=spherex_dr1
# Parallel cutout downloads per job: the S3 byte ranges cope; IRSA's cutout service gets at most
# two requests at a time regardless.
SKYSHIFT_DOWNLOAD_WORKERS=8
SKYSHIFT_HTTP_TIMEOUT_S=90
# POST /api/frames answers 503 "Busy" while more than this many jobs wait in the queue.
SKYSHIFT_MAX_QUEUED=20
# Queues one worker process takes, comma-separated (frames, slow); empty = both, frames first.
# docker compose sets it per worker, so the slow spectrum jobs, track follow-ups and JPL lookups never delay a frame job.
# SKYSHIFT_WORKER_QUEUES=

# Production only (docker-compose.prod.yml): the public host name Caddy serves with HTTPS.
# The DNS A record must point to the server before the first start.
DOMAIN=
