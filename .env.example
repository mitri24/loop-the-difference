# Optional overrides – copy to .env
# Newer SPHEREx data release? Change the collection here, nothing else.
SKYSHIFT_SPHEREX_COLLECTION=spherex_dr1
SKYSHIFT_DOWNLOAD_WORKERS=4
SKYSHIFT_HTTP_TIMEOUT_S=90
# POST /api/frames answers 503 "Busy" while more than this many jobs wait in the queue.
SKYSHIFT_MAX_QUEUED=20
